  "claim": {
    "name": "GLOBAL_GROUP_MONOTONICITY_WITHOUT_PROFILE_PREMISE",
    "control_group": "(R,+)",
    "response_group": "((-1,1),C)",
    "generator": "a(x)=partial_2 C(x,0)",
    "differential_identity": "sigma_prime(u)=kappa*a(sigma(u))",
    "conclusions": [
      "a(x)>0 on (-1,1)",
      "sigma_prime(u)>0 for every u in R",
      "sigma is a strictly increasing bijection R -> (-1,1)",
      "lim_{u->plus_or_minus_infinity} sigma(u)=plus_or_minus_1"
    ]
  },
  "hypotheses": [
    {
      "id": "H1_GLOBAL_RESPONSE_GROUP",
      "statement": "C is a C1 group law on the connected interval (-1,1) with identity 0",
      "status": "REQUIRED"
    },
    {
      "id": "H2_TRANSLATION_DIFFEOMORPHISMS",
      "statement": "every translation L_x(y)=C(x,y) is a C1 diffeomorphism",
      "status": "REQUIRED"
    },
    {
      "id": "H3_GLOBAL_CONTROL_HOMOMORPHISM",
      "statement": "sigma(u+v)=C(sigma(u),sigma(v)) for all u,v in R",
      "status": "REQUIRED"
    },
    {
      "id": "H4_POSITIVE_ORIENTATION",
      "statement": "kappa=sigma_prime(0)>0 in the global additive control coordinate",
      "status": "REQUIRED"
    }
  ],
  "proof_steps": [
    {
      "id": "P1_GENERATOR_NONZERO",
      "derives": "a(x) is continuous and nonzero",
      "from": [
        "H1_GLOBAL_RESPONSE_GROUP",
        "H2_TRANSLATION_DIFFEOMORPHISMS"
      ]
    },
    {
      "id": "P2_GENERATOR_POSITIVE",
      "derives": "a(x)>0 because a(0)=1 and (-1,1) is connected",
      "from": [
        "P1_GENERATOR_NONZERO"
      ]
    },
    {
      "id": "P3_DIFFERENTIAL_IDENTITY",
      "derives": "sigma_prime(u)=kappa*a(sigma(u))",
      "from": [
        "H3_GLOBAL_CONTROL_HOMOMORPHISM",
        "H4_POSITIVE_ORIENTATION"
      ]
    },
    {
      "id": "P4_STRICT_MONOTONICITY",
      "derives": "sigma_prime(u)>0 globally",
      "from": [
        "P2_GENERATOR_POSITIVE",
        "P3_DIFFERENTIAL_IDENTITY"
      ]
    },
    {
      "id": "P5_SURJECTIVITY",
      "derives": "the image is an open subgroup and hence the full connected response group",
      "from": [
        "P4_STRICT_MONOTONICITY",
        "H3_GLOBAL_CONTROL_HOMOMORPHISM"
      ]
    },
    {
      "id": "P6_ENDPOINT_SATURATION",
      "derives": "the monotone surjection has endpoint limits -1 and +1",
      "from": [
        "P4_STRICT_MONOTONICITY",
        "P5_SURJECTIVITY"
      ]
    }
  ],
  "normalization_audit": {
    "axiom_B_unscaled_slope": "dS_T/dg(0)=c_1>0",
    "normalized_slope": "dsigma/dg(0)=c_1/S_max>0",
    "global_coordinate_slope": "kappa=dsigma/du(0)>0 when du/dg(0)>0",
    "rejected_identity": "sigma_prime(0)=c_1"
  },
